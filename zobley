<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import {
  getAuth, createUserWithEmailAndPassword, signInWithEmailAndPassword,
  onAuthStateChanged, signOut, updateProfile
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
import {
  getFirestore, collection, addDoc, doc, setDoc, getDoc, getDocs,
  query, onSnapshot, serverTimestamp, updateDoc, arrayUnion, orderBy
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
import {
  getStorage, ref, uploadBytes, getDownloadURL
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-storage.js";

const firebaseConfig = {
  apiKey: "AIzaSyAhd10JgBcSsSDTjV3spsLon_uQllJ-A7Q",
  authDomain: "kaamsetu-feec2.firebaseapp.com",
  projectId: "kaamsetu-feec2",
  storageBucket: "kaamsetu-feec2.firebasestorage.app",
  messagingSenderId: "232527156688",
  appId: "1:232527156688:web:538fb6a1f09032053a95d5"
};

const fbApp = initializeApp(firebaseConfig);
const auth = getAuth(fbApp);
const db = getFirestore(fbApp);
const storage = getStorage(fbApp);

const CATEGORIES = ["Video editing","Graphic design","Content writing","Social media","Web/App dev","Voiceover","Other"];
let jobs = [];
let profiles = {};        // keyed by uid
let chatsCache = {};       // keyed by chatId -> {participants, names, messages, readBy}
let unsubChats = [];
let currentUid = null;
let currentName = null;
let activeThread = null;   // {uid, name}
let activeCategory = "All";
let authMode = "login";

function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 1800);
}
function initials(name){
  return (name||'?').trim().split(/\s+/).slice(0,2).map(w=>w[0]?.toUpperCase()||'').join('');
}
function escapeHtml(str){
  if(str===undefined || str===null) return '';
  return String(str).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function escapeAttr(str){ return escapeHtml(str).replace(/'/g,"&#39;"); }
function nameToEmail(name){
  const clean = name.toLowerCase().replace(/[^a-z0-9]/g,'');
  return clean + "@kaamsetu-users.app";
}
function chatId(a,b){ return [a,b].sort().join("__"); }

function previewImage(inputId, imgId){
  const input = document.getElementById(inputId);
  const img = document.getElementById(imgId);
  const file = input.files && input.files[0];
  if(!file){ img.style.display='none'; return; }
  img.src = URL.createObjectURL(file);
  img.style.display='block';
}
window.previewImage = previewImage;

async function uploadImageIfAny(inputId, pathPrefix){
  const input = document.getElementById(inputId);
  const file = input.files && input.files[0];
  if(!file) return null;
  const path = `${pathPrefix}/${currentUid}-${Date.now()}-${file.name}`;
  const sref = ref(storage, path);
  await uploadBytes(sref, file);
  return await getDownloadURL(sref);
}

/* ---------------- AUTH ---------------- */
function toggleAuthMode(){
  authMode = authMode === "login" ? "signup" : "login";
  document.getElementById('auth-btn').textContent = authMode === "login" ? "Login" : "Sign up";
  document.getElementById('auth-toggle').innerHTML = authMode === "login"
    ? `Don't have an account? <span onclick="toggleAuthMode()">Sign up</span>`
    : `Already have an account? <span onclick="toggleAuthMode()">Log in</span>`;
  document.getElementById('auth-error').classList.add('hidden');
}
window.toggleAuthMode = toggleAuthMode;

async function handleAuth(){
  const name = document.getElementById('auth-name').value.trim();
  const pass = document.getElementById('auth-pass').value;
  const errBox = document.getElementById('auth-error');
  errBox.classList.add('hidden');
  if(!name || !pass){ errBox.textContent = "Please enter both name and password"; errBox.classList.remove('hidden'); return; }
  if(pass.length < 6){ errBox.textContent = "Password must be at least 6 characters"; errBox.classList.remove('hidden'); return; }

  const email = nameToEmail(name);
  const btn = document.getElementById('auth-btn');
  btn.disabled = true;
  btn.textContent = "Please wait...";

  try{
    if(authMode === "signup"){
      const cred = await createUserWithEmailAndPassword(auth, email, pass);
      await updateProfile(cred.user, { displayName: name });
      await setDoc(doc(db, "users", cred.user.uid), { name, createdAt: serverTimestamp() });
      toast("Account created");
    } else {
      await signInWithEmailAndPassword(auth, email, pass);
    }
  }catch(e){
    let msg = "Something went wrong, please try again";
    if(e.code === 'auth/email-already-in-use') msg = "This name is already taken, try another or log in";
    else if(e.code === 'auth/invalid-credential' || e.code === 'auth/wrong-password' || e.code === 'auth/user-not-found') msg = "Incorrect name or password";
    else if(e.code === 'auth/weak-password') msg = "Password must be at least 6 characters";
    else if(e.code === 'auth/network-request-failed') msg = "Check your internet connection";
    errBox.textContent = msg;
    errBox.classList.remove('hidden');
  }
  btn.disabled = false;
  btn.textContent = authMode === "login" ? "Login" : "Sign up";
}
window.handleAuth = handleAuth;

async function logout(){
  cleanupListeners();
  await signOut(auth);
}
window.logout = logout;

onAuthStateChanged(auth, async (user)=>{
  if(user){
    currentUid = user.uid;
    currentName = user.displayName || "User";
    document.getElementById('auth-screen').classList.add('hidden');
    document.getElementById('app').classList.remove('hidden');
    document.getElementById('who-name').textContent = currentName;
    document.getElementById('auth-name').value='';
    document.getElementById('auth-pass').value='';
    await startListeners();
  } else {
    currentUid = null; currentName = null;
    document.getElementById('app').classList.add('hidden');
    document.getElementById('auth-screen').classList.remove('hidden');
  }
});

/* ---------------- LISTENERS ---------------- */
function cleanupListeners(){
  unsubChats.forEach(u=>{ try{u();}catch(e){} });
  unsubChats = [];
}

async function startListeners(){
  renderCategoryChips();

  onSnapshot(query(collection(db, "jobs")), (snap)=>{
    jobs = [];
    snap.forEach(d=> jobs.push({ id: d.id, ...d.data() }));
    jobs.sort((a,b)=> (b.createdAtMs||0) - (a.createdAtMs||0));
    renderJobs();
  });

  onSnapshot(query(collection(db, "profiles")), (snap)=>{
    profiles = {};
    snap.forEach(d=> profiles[d.id] = d.data());
    renderProfiles();
  });

  onSnapshot(query(collection(db, "chats")), (snap)=>{
    let changed = false;
    snap.forEach(d=>{
      const data = d.data();
      if(data.participants && data.participants.includes(currentUid)){
        chatsCache[d.id] = data;
        changed = true;
      }
    });
    if(changed){
      renderChats();
      if(activeThread) renderThread();
    }
  });
}

/* ---------------- NAV ---------------- */
function switchTab(tab){
  document.querySelectorAll('.tab-view').forEach(v=>v.classList.add('hidden'));
  document.getElementById('view-'+tab).classList.remove('hidden');
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.toggle('active', b.dataset.tab===tab));
  const subs = {
    jobs: "Post jobs, find freelancers, or find work — all in one place.",
    post: "Post your job here, freelancers will reach out.",
    profiles: "Create your profile so clients can find you.",
    chat: "Chat directly with clients or freelancers."
  };
  document.getElementById('topbar-sub').textContent = subs[tab];
  if(tab !== 'chat') closeThread();
  if(tab === 'chat') document.getElementById('chat-badge').classList.add('hidden');
}
window.switchTab = switchTab;

/* ---------------- JOBS ---------------- */
function renderCategoryChips(){
  const wrap = document.getElementById('jobs-chips');
  const cats = ["All", ...CATEGORIES];
  wrap.innerHTML = cats.map(c=>`<div class="chip ${c===activeCategory?'active':''}" onclick="setCategory('${escapeAttr(c)}')">${escapeHtml(c)}</div>`).join('');
}
function setCategory(c){ activeCategory = c; renderCategoryChips(); renderJobs(); }
window.setCategory = setCategory;

function renderJobs(){
  const list = document.getElementById('jobs-list');
  const q = (document.getElementById('jobs-search').value || '').toLowerCase().trim();
  let filtered = jobs.filter(j=>{
    const matchesCat = activeCategory === "All" || j.category === activeCategory;
    const matchesQ = !q || (j.title||'').toLowerCase().includes(q) || (j.desc||'').toLowerCase().includes(q);
    return matchesCat && matchesQ;
  });
  document.getElementById('jobs-count').textContent = filtered.length + (filtered.length===1?' job':' jobs');
  if(filtered.length===0){
    list.innerHTML = `<div class="empty"><div class="empty-icon"><svg viewBox="0 0 100 100" width="34" height="34" style="opacity:0.35" role="img" aria-label="Zobley mascot"><path d="M 18 46 Q 50 12 82 46 L 82 34 Q 50 2 18 34 Z" fill="#8A7CFF"/><rect x="14" y="34" width="72" height="12" rx="6" fill="#6C5CE8"/><circle cx="38" cy="60" r="6" fill="#F2F2FC"/><circle cx="62" cy="60" r="6" fill="#F2F2FC"/><path d="M 38 76 Q 50 86 62 76" fill="none" stroke="#F2F2FC" stroke-width="4.5" stroke-linecap="round"/></svg></div><div class="empty-title">No jobs found</div><div class="empty-body">Try clearing filters/search, or post a job yourself.</div></div>`;
    return;
  }
  list.innerHTML = filtered.map(job=>`
    <div class="card job-card">
      <div class="job-top">
        <div class="job-title">${escapeHtml(job.title)}</div>
        <div class="job-budget">₹${escapeHtml(job.budget || '—')}</div>
      </div>
      ${job.imageUrl ? `<img src="${escapeAttr(job.imageUrl)}" class="job-image">` : ''}
      <div class="job-desc">${escapeHtml(job.desc)}</div>
      <div class="job-meta"><span class="tag cat">${escapeHtml(job.category)}</span></div>
      <div class="job-foot">
        <div class="poster">Posted by ${escapeHtml(job.name)}</div>
        ${job.uid !== currentUid ? `<button class="btn btn-ghost btn-sm" onclick="startChatWith('${escapeAttr(job.uid)}','${escapeAttr(job.name)}')">Message</button>` : `<span class="tag">Your post</span>`}
      </div>
    </div>`).join('');
}

async function postJob(){
  const title = document.getElementById('post-title').value.trim();
  const desc = document.getElementById('post-desc').value.trim();
  const category = document.getElementById('post-category').value;
  const budget = document.getElementById('post-budget').value.trim();
  if(!title || !desc){ toast("Please fill in title and details"); return; }
  const btn = document.getElementById('post-btn');
  btn.disabled = true;
  btn.textContent = "Posting...";
  try{
    const imageUrl = await uploadImageIfAny('post-image', 'job-images');
    await addDoc(collection(db, "jobs"), {
      title, desc, category, budget, imageUrl: imageUrl || null, name: currentName, uid: currentUid,
      createdAt: serverTimestamp(), createdAtMs: Date.now()
    });
    document.getElementById('post-title').value='';
    document.getElementById('post-desc').value='';
    document.getElementById('post-budget').value='';
    document.getElementById('post-image').value='';
    document.getElementById('post-image-preview').style.display='none';
    toast("Job posted");
    showSuggestions(category);
  }catch(e){
    toast("Couldn't post, try again");
  }
  btn.disabled = false;
  btn.textContent = "Post job";
}
window.postJob = postJob;

function showSuggestions(category){
  const words = category.toLowerCase().split(/[\s\/]+/).filter(Boolean);
  const matches = Object.keys(profiles).filter(uid=>{
    if(uid === currentUid) return false;
    const skill = (profiles[uid].skill || '').toLowerCase();
    const bio = (profiles[uid].bio || '').toLowerCase();
    return words.some(w => skill.includes(w) || bio.includes(w));
  }).slice(0, 3);
  const wrap = document.getElementById('suggest-wrap');
  const list = document.getElementById('suggest-list');
  if(matches.length === 0){ wrap.classList.add('hidden'); return; }
  list.innerHTML = matches.map(uid=>{
    const p = profiles[uid];
    return `<div class="card profile-card">
      <div class="avatar">${p.photoUrl ? `<img src="${escapeAttr(p.photoUrl)}">` : escapeHtml(initials(p.name))}</div>
      <div class="profile-info">
        <div class="profile-name">${escapeHtml(p.name)}</div>
        <div class="profile-skill">${escapeHtml(p.skill)}</div>
        <div class="rate-btn-row">
          <button class="btn btn-ghost btn-sm" onclick="startChatWith('${escapeAttr(uid)}','${escapeAttr(p.name)}')">Message</button>
        </div>
      </div>
    </div>`;
  }).join('');
  wrap.classList.remove('hidden');
}
window.showSuggestions = showSuggestions;

/* ---------------- PROFILES ---------------- */
function avgRating(p){
  if(!p.ratings || p.ratings.length===0) return null;
  const sum = p.ratings.reduce((a,r)=>a+r.stars,0);
  return (sum / p.ratings.length);
}
function starString(avg){
  const rounded = Math.round(avg);
  return "★".repeat(rounded) + "☆".repeat(5-rounded);
}

function renderProfiles(){
  const list = document.getElementById('profiles-list');
  const q = (document.getElementById('profiles-search').value || '').toLowerCase().trim();
  const uids = Object.keys(profiles).filter(uid=>{
    const p = profiles[uid];
    return !q || (p.skill||'').toLowerCase().includes(q) || (p.name||'').toLowerCase().includes(q);
  });
  if(uids.length===0){
    list.innerHTML = `<div class="empty"><div class="empty-icon"><svg viewBox="0 0 100 100" width="34" height="34" style="opacity:0.35" role="img" aria-label="Zobley mascot"><path d="M 18 46 Q 50 12 82 46 L 82 34 Q 50 2 18 34 Z" fill="#8A7CFF"/><rect x="14" y="34" width="72" height="12" rx="6" fill="#6C5CE8"/><circle cx="38" cy="60" r="6" fill="#F2F2FC"/><circle cx="62" cy="60" r="6" fill="#F2F2FC"/><path d="M 38 76 Q 50 86 62 76" fill="none" stroke="#F2F2FC" stroke-width="4.5" stroke-linecap="round"/></svg></div><div class="empty-title">No profiles found</div><div class="empty-body">Create your profile so clients can find you.</div></div>`;
    return;
  }
  list.innerHTML = uids.map(uid=>{
    const p = profiles[uid];
    const avg = avgRating(p);
    return `
    <div class="card profile-card">
      <div class="avatar">${p.photoUrl ? `<img src="${escapeAttr(p.photoUrl)}">` : escapeHtml(initials(p.name))}</div>
      <div class="profile-info">
        <div class="job-top">
          <div>
            <div class="profile-name">${escapeHtml(p.name)}</div>
            <div class="profile-skill">${escapeHtml(p.skill)}</div>
          </div>
          <div class="profile-rate">₹${escapeHtml(p.rate || '—')}</div>
        </div>
        <div class="profile-bio">${escapeHtml(p.bio)}</div>
        <div class="rating-line">
          ${avg ? `<span class="stars">${starString(avg)}</span><span class="rating-count">${avg.toFixed(1)} (${p.ratings.length})</span>` : `<span class="rating-count">No ratings yet</span>`}
        </div>
        <div class="rate-btn-row">
          ${uid !== currentUid ? `<button class="btn btn-ghost btn-sm" onclick="startChatWith('${escapeAttr(uid)}','${escapeAttr(p.name)}')">Message</button>
          <button class="btn btn-violet btn-sm" onclick="openRateBox('${escapeAttr(uid)}')">Rate</button>` : `<span class="tag">This is your profile</span>`}
        </div>
        <div id="rate-box-${escapeAttr(uid)}" class="hidden" style="margin-top:10px;">
          <div class="star-picker" id="star-picker-${escapeAttr(uid)}"></div>
          <input type="text" id="rate-comment-${escapeAttr(uid)}" placeholder="Short comment (optional)">
          <button class="btn btn-primary btn-sm btn-block" style="margin-top:8px;" onclick="submitRating('${escapeAttr(uid)}')">Submit rating</button>
        </div>
      </div>
    </div>`;
  }).join('');
}

let pendingStars = 0;
function openRateBox(uid){
  pendingStars = 0;
  const box = document.getElementById('rate-box-'+uid);
  box.classList.toggle('hidden');
  const picker = document.getElementById('star-picker-'+uid);
  picker.innerHTML = [1,2,3,4,5].map(i=>`<span class="star-pick" data-i="${i}" onclick="pickStar('${escapeAttr(uid)}',${i})">★</span>`).join('');
}
window.openRateBox = openRateBox;
function pickStar(uid, i){
  pendingStars = i;
  const picker = document.getElementById('star-picker-'+uid);
  picker.querySelectorAll('.star-pick').forEach(el=>{
    el.classList.toggle('on', parseInt(el.dataset.i) <= i);
  });
}
window.pickStar = pickStar;
async function submitRating(uid){
  if(pendingStars === 0){ toast("Select a star rating first"); return; }
  const comment = document.getElementById('rate-comment-'+uid).value.trim();
  try{
    await updateDoc(doc(db, "profiles", uid), {
      ratings: arrayUnion({ byUid: currentUid, byName: currentName, stars: pendingStars, comment })
    });
    toast("Rating submitted");
  }catch(e){ toast("Couldn't save rating"); }
}
window.submitRating = submitRating;

function openMyProfileForm(){
  const existing = profiles[currentUid];
  if(existing){
    document.getElementById('prof-skill').value = existing.skill || '';
    document.getElementById('prof-bio').value = existing.bio || '';
    document.getElementById('prof-rate').value = existing.rate || '';
  }
  document.getElementById('my-profile-form').classList.toggle('hidden');
}
window.openMyProfileForm = openMyProfileForm;

async function saveProfile(){
  const skill = document.getElementById('prof-skill').value.trim();
  const bio = document.getElementById('prof-bio').value.trim();
  const rate = document.getElementById('prof-rate').value.trim();
  if(!skill){ toast("Please enter your skill"); return; }
  try{
    const existing = profiles[currentUid];
    const ratings = (existing && existing.ratings) || [];
    const photoUrl = (await uploadImageIfAny('prof-photo', 'profile-photos')) || (existing && existing.photoUrl) || null;
    await setDoc(doc(db, "profiles", currentUid), { name: currentName, skill, bio, rate, ratings, photoUrl });
    document.getElementById('my-profile-form').classList.add('hidden');
    document.getElementById('prof-photo').value='';
    document.getElementById('prof-photo-preview').style.display='none';
    toast("Profile saved");
  }catch(e){ toast("Couldn't save"); }
}
window.saveProfile = saveProfile;

/* ---------------- CHAT ---------------- */
function startChatWith(uid, name){
  switchTab('chat');
  openThread(uid, name);
}
window.startChatWith = startChatWith;

async function openThread(uid, name){
  activeThread = { uid, name };
  document.getElementById('chat-list-wrap').classList.add('hidden');
  document.getElementById('chat-thread').classList.add('active');
  document.getElementById('thread-name').textContent = name;
  const id = chatId(currentUid, uid);
  if(!chatsCache[id]){
    chatsCache[id] = { participants:[currentUid, uid], names:{[currentUid]:currentName,[uid]:name}, messages:[], readBy:[currentUid] };
  }
  try{
    await setDoc(doc(db, "chats", id), {
      participants:[currentUid, uid],
      names:{ [currentUid]: currentName, [uid]: name },
      readBy: arrayUnion(currentUid)
    }, { merge: true });
  }catch(e){}
  renderThread();
}
window.openThread = openThread;

function closeThread(){
  activeThread = null;
  document.getElementById('chat-list-wrap').classList.remove('hidden');
  document.getElementById('chat-thread').classList.remove('active');
  renderChats();
}
window.closeThread = closeThread;

function renderThread(){
  if(!activeThread) return;
  const body = document.getElementById('chat-body');
  const id = chatId(currentUid, activeThread.uid);
  const data = chatsCache[id];
  const msgs = (data && data.messages) || [];
  if(msgs.length===0){
    body.innerHTML = `<div class="empty" style="padding:24px 8px;"><div class="empty-body">Send ${escapeHtml(activeThread.name)} a message here.</div></div>`;
    return;
  }
  body.innerHTML = msgs.map(m=>`<div class="bubble ${m.from===currentUid?'me':'them'}">${escapeHtml(m.text)}</div>`).join('');
  body.scrollTop = body.scrollHeight;
}

async function sendMsg(){
  const input = document.getElementById('chat-input');
  const text = input.value.trim();
  if(!text || !activeThread) return;
  const id = chatId(currentUid, activeThread.uid);
  input.value = '';
  try{
    await setDoc(doc(db, "chats", id), {
      participants:[currentUid, activeThread.uid],
      names:{ [currentUid]: currentName, [activeThread.uid]: activeThread.name },
      messages: arrayUnion({ from: currentUid, text, time: Date.now() }),
      readBy: [currentUid]
    }, { merge: true });
    await updateDoc(doc(db,"chats",id), { readBy: [currentUid] });
  }catch(e){ toast("Couldn't send message"); }
}
window.sendMsg = sendMsg;

document.addEventListener('keydown', e=>{
  if(e.key==='Enter' && document.activeElement.id==='chat-input') sendMsg();
});

function renderChats(){
  const wrap = document.getElementById('chats-list');
  const ids = Object.keys(chatsCache).filter(id => chatsCache[id].messages && chatsCache[id].messages.length > 0);
  let hasUnread = false;
  if(ids.length===0){
    wrap.innerHTML = `<div class="empty"><div class="empty-icon"><svg viewBox="0 0 100 100" width="34" height="34" style="opacity:0.35" role="img" aria-label="Zobley mascot"><path d="M 18 46 Q 50 12 82 46 L 82 34 Q 50 2 18 34 Z" fill="#8A7CFF"/><rect x="14" y="34" width="72" height="12" rx="6" fill="#6C5CE8"/><circle cx="38" cy="60" r="6" fill="#F2F2FC"/><circle cx="62" cy="60" r="6" fill="#F2F2FC"/><path d="M 38 76 Q 50 86 62 76" fill="none" stroke="#F2F2FC" stroke-width="4.5" stroke-linecap="round"/></svg></div><div class="empty-title">No messages yet</div><div class="empty-body">Tap "Message" on a job or profile to start a chat.</div></div>`;
    document.getElementById('chat-badge').classList.add('hidden');
    return;
  }
  wrap.innerHTML = ids.map(id=>{
    const data = chatsCache[id];
    const otherUid = data.participants.find(p => p !== currentUid);
    const otherName = (data.names && data.names[otherUid]) || 'User';
    const msgs = data.messages;
    const last = msgs[msgs.length-1];
    const readBy = data.readBy || [];
    const unread = !readBy.includes(currentUid) && last.from !== currentUid;
    if(unread) hasUnread = true;
    return `<div class="chat-list-item" onclick="openThread('${escapeAttr(otherUid)}','${escapeAttr(otherName)}')">
      <div class="avatar">${escapeHtml(initials(otherName))}</div>
      <div class="chat-preview">
        <div class="chat-preview-name">${escapeHtml(otherName)}</div>
        <div class="chat-preview-msg">${last ? escapeHtml(last.text) : ''}</div>
      </div>
      ${unread ? '<div class="unread-dot"></div>' : ''}
    </div>`;
  }).join('');
  document.getElementById('chat-badge').classList.toggle('hidden', !hasUnread);
}
</script>
</body>
</html>
