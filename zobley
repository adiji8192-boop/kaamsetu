<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zobley — freelance marketplace</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20width%3D%22512%22%20height%3D%22512%22%20viewBox%3D%220%200%20512%20512%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20role%3D%22img%22%20aria-label%3D%22Zobley%20app%20icon%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22bg%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%221%22%20y2%3D%221%22%3E%3Cstop%20offset%3D%220%25%22%20stop-color%3D%22%23FFC24D%22/%3E%3Cstop%20offset%3D%22100%25%22%20stop-color%3D%22%23FF8A3D%22/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width%3D%22512%22%20height%3D%22512%22%20rx%3D%22112%22%20fill%3D%22url%28%23bg%29%22/%3E%3Cpath%20d%3D%22M%20122%20246%20Q%20256%20100%20390%20246%20L%20390%20208%20Q%20256%2062%20122%20208%20Z%22%20fill%3D%22%236C5CE8%22/%3E%3Crect%20x%3D%22110%22%20y%3D%22208%22%20width%3D%22292%22%20height%3D%2246%22%20rx%3D%2223%22%20fill%3D%22%234A3FC4%22/%3E%3Ccircle%20cx%3D%22206%22%20cy%3D%22320%22%20r%3D%2224%22%20fill%3D%22%23241300%22/%3E%3Ccircle%20cx%3D%22306%22%20cy%3D%22320%22%20r%3D%2224%22%20fill%3D%22%23241300%22/%3E%3Cpath%20d%3D%22M%20200%20372%20Q%20256%20410%20312%20372%22%20fill%3D%22none%22%20stroke%3D%22%23241300%22%20stroke-width%3D%2218%22%20stroke-linecap%3D%22round%22/%3E%3Cpath%20d%3D%22M%2090%20430%20Q%20256%20380%20422%20430%22%20fill%3D%22none%22%20stroke%3D%22%23FFF6E5%22%20stroke-width%3D%2210%22%20stroke-linecap%3D%22round%22%20stroke-dasharray%3D%222%2024%22%20opacity%3D%220.55%22/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0A0B18;
    --bg-2:#0E1024;
    --surface:rgba(22,24,48,0.72);
    --surface-solid:#161830;
    --surface-2:rgba(255,255,255,0.05);
    --ink:#F2F2FC;
    --ink-soft:#A6A9D6;
    --ink-faint:#5F628E;
    --indigo:#6C5CE8;
    --indigo-soft:#8A7CFF;
    --indigo-dark:#12132A;
    --indigo-glow:rgba(108,92,232,0.5);
    --marigold:#FFB020;
    --marigold-dark:#7A4E00;
    --marigold-tint:rgba(255,176,32,0.14);
    --marigold-glow:rgba(255,176,32,0.4);
    --teal:#2EE6B8;
    --teal-tint:rgba(46,230,184,0.13);
    --coral:#FF5C7A;
    --coral-tint:rgba(255,92,122,0.14);
    --violet-tint:rgba(138,124,255,0.14);
    --violet:#B4A8FF;
    --star:#FFB020;
    --border:rgba(255,255,255,0.09);
    --border-soft:rgba(255,255,255,0.05);
    --radius:14px;
    --mono:'JetBrains Mono', monospace;
  }
  *{box-sizing:border-box;}
  html{background:var(--bg);}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:'Inter',sans-serif;-webkit-font-smoothing:antialiased;}
  .display{font-family:'Sora',sans-serif;}
  #app{
    max-width:460px;margin:0 auto;min-height:100vh;
    background:
      radial-gradient(560px 320px at 12% -6%, rgba(108,92,232,0.16), transparent 60%),
      radial-gradient(420px 260px at 100% 8%, rgba(255,176,32,0.10), transparent 60%),
      var(--bg);
    display:flex;flex-direction:column;position:relative;padding-bottom:86px;
  }
  .hidden{display:none !important;}

  #auth-screen{
    min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding:32px 26px;
    background:
      radial-gradient(600px 380px at 15% 0%, rgba(108,92,232,0.30), transparent 60%),
      radial-gradient(500px 320px at 100% 100%, rgba(255,176,32,0.16), transparent 55%),
      linear-gradient(165deg, #0D0E22 0%, #08091A 100%);
    color:#fff;position:relative;overflow:hidden;
  }
  #auth-screen::before{
    content:'';position:absolute;inset:0;pointer-events:none;opacity:0.35;
    background-image:
      linear-gradient(rgba(255,255,255,0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.045) 1px, transparent 1px);
    background-size:34px 34px;
    mask-image:radial-gradient(560px 420px at 30% 20%, #000, transparent 75%);
  }
  .bridge-scene{position:relative;width:100%;max-width:340px;margin:0 0 22px;opacity:0.9;}
  .bridge-scene svg{width:100%;height:auto;overflow:visible;}
  .bridge-arc{fill:none;stroke:url(#none);stroke:rgba(255,255,255,0.22);stroke-width:1.6;stroke-dasharray:4 6;}
  .bridge-node{fill:var(--marigold);filter:drop-shadow(0 0 6px var(--marigold-glow));}
  .bridge-pulse{fill:var(--indigo-soft);filter:drop-shadow(0 0 8px var(--indigo-glow));}
  @media (prefers-reduced-motion: reduce){
    .bridge-pulse animateMotion{display:none;}
  }
  .auth-mark{
    width:52px;height:52px;border-radius:15px;background:linear-gradient(150deg, var(--marigold), #FF8A3D);
    display:flex;align-items:center;justify-content:center;font-family:'Sora',sans-serif;font-weight:800;
    color:#241300;font-size:20px;margin-bottom:16px;box-shadow:0 0 0 1px rgba(255,255,255,0.08), 0 10px 30px -8px var(--marigold-glow);
    position:relative;z-index:1;
  }
  .auth-title{font-family:'Sora',sans-serif;font-weight:800;font-size:27px;letter-spacing:-0.3px;position:relative;z-index:1;}
  .auth-sub{color:var(--ink-soft);font-size:13.5px;margin-top:5px;margin-bottom:26px;line-height:1.5;position:relative;z-index:1;}
  .auth-card{
    background:rgba(255,255,255,0.045);border:1px solid rgba(255,255,255,0.10);border-radius:18px;padding:20px;
    backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);position:relative;z-index:1;
    box-shadow:0 20px 50px -20px rgba(0,0,0,0.6);
  }
  .auth-card label{color:#C7C9F0;}
  .auth-card input{background:rgba(0,0,0,0.25);border:1px solid rgba(255,255,255,0.14);color:#fff;}
  .auth-card input:focus{outline:2px solid var(--indigo-soft);outline-offset:1px;border-color:transparent;}
  .auth-card input::placeholder{color:#63659A;}
  .auth-toggle{text-align:center;margin-top:16px;font-size:12.5px;color:var(--ink-soft);position:relative;z-index:1;}
  .auth-toggle span{color:var(--marigold);font-weight:600;cursor:pointer;}
  .auth-error{background:rgba(255,92,122,0.16);border:1px solid rgba(255,92,122,0.3);color:#FFCBD6;font-size:12px;padding:8px 12px;border-radius:8px;margin-top:12px;}
  .auth-loading{text-align:center;color:var(--ink-soft);font-size:13px;padding:40px 0;position:relative;z-index:1;}

  .topbar{
    position:relative;overflow:hidden;
    background:linear-gradient(155deg, #1B1740 0%, #0F1030 100%);
    padding:18px 20px 22px;border-radius:0 0 22px 22px;color:#fff;
    border-bottom:1px solid rgba(255,255,255,0.06);
  }
  .topbar::before{
    content:'';position:absolute;inset:0;pointer-events:none;
    background-image:linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size:22px 22px;
    mask-image:linear-gradient(180deg, #000, transparent 85%);
    opacity:0.5;
  }
  .topbar::after{
    content:'';position:absolute;top:-40px;right:-30px;width:160px;height:160px;border-radius:50%;
    background:radial-gradient(circle, var(--marigold-glow), transparent 70%);opacity:0.5;pointer-events:none;
  }
  .topbar-row{display:flex;justify-content:space-between;align-items:flex-start;position:relative;z-index:1;}
  .brand{display:flex;align-items:center;gap:10px;}
  .brand-mark{width:34px;height:34px;border-radius:10px;background:linear-gradient(150deg, var(--marigold), #FF8A3D);display:flex;align-items:center;justify-content:center;font-family:'Sora',sans-serif;font-weight:800;color:#241300;font-size:16px;flex-shrink:0;box-shadow:0 6px 18px -6px var(--marigold-glow);}
  .brand-name{font-family:'Sora',sans-serif;font-weight:700;font-size:19px;letter-spacing:0.2px;}
  .brand-tag{font-size:11.5px;color:var(--ink-soft);margin-top:1px;font-family:var(--mono);letter-spacing:0.2px;}
  .who{text-align:right;}
  .who-name{font-size:12.5px;font-weight:600;}
  .who-logout{font-size:11px;color:var(--ink-soft);cursor:pointer;margin-top:2px;text-decoration:underline;}
  .topbar-sub{margin-top:14px;font-size:13px;color:var(--ink-soft);line-height:1.5;position:relative;z-index:1;}

  .section{padding:18px 18px 8px;}
  .section-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:12px;}
  .section-title{font-family:'Sora',sans-serif;font-weight:700;font-size:16px;color:var(--ink);}
  .section-count{font-size:11.5px;color:var(--ink-faint);font-family:var(--mono);}
  .tab-view{display:block;}

  .search-wrap{position:relative;margin-bottom:12px;}
  .search-wrap input{padding-left:34px;}
  .search-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--ink-faint);font-size:13px;}
  .chip-row{display:flex;gap:7px;overflow-x:auto;padding-bottom:4px;margin-bottom:14px;}
  .chip-row::-webkit-scrollbar{display:none;}
  .chip{flex-shrink:0;font-size:12px;font-weight:600;padding:6px 13px;border-radius:20px;background:var(--surface-2);border:1px solid var(--border);color:var(--ink-soft);cursor:pointer;white-space:nowrap;transition:background .12s ease, color .12s ease;}
  .chip.active{background:linear-gradient(135deg, var(--indigo), #4A3FC4);color:#fff;border-color:transparent;box-shadow:0 6px 16px -8px var(--indigo-glow);}

  .card{
    background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px 15px;margin-bottom:10px;
    backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);transition:border-color .15s ease, transform .15s ease;
  }
  .card:hover{border-color:rgba(108,92,232,0.35);}
  .job-card{display:flex;flex-direction:column;gap:6px;}
  .job-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;}
  .job-title{font-weight:600;font-size:14.5px;line-height:1.35;color:var(--ink);}
  .job-budget{font-family:var(--mono);font-weight:700;font-size:14px;color:var(--teal);white-space:nowrap;}
  .job-desc{font-size:13px;color:var(--ink-soft);line-height:1.5;}
  .job-meta{display:flex;align-items:center;gap:8px;margin-top:4px;flex-wrap:wrap;}
  .tag{font-size:11px;font-weight:600;padding:3px 9px;border-radius:20px;background:var(--surface-2);color:var(--ink-soft);border:1px solid var(--border-soft);}
  .tag.cat{background:var(--marigold-tint);color:var(--marigold);border-color:rgba(255,176,32,0.25);}
  .job-foot{display:flex;justify-content:space-between;align-items:center;margin-top:8px;padding-top:10px;border-top:1px solid var(--border-soft);}
  .poster{font-size:12px;color:var(--ink-faint);}
  .btn{font-family:'Inter',sans-serif;border:none;border-radius:10px;padding:9px 14px;font-size:13px;font-weight:600;cursor:pointer;transition:transform .08s ease, box-shadow .12s ease;}
  .btn:active{transform:scale(0.97);}
  .btn-primary{background:linear-gradient(135deg, var(--indigo), #4A3FC4);color:#fff;box-shadow:0 8px 20px -10px var(--indigo-glow);}
  .btn-marigold{background:linear-gradient(135deg, var(--marigold), #FF8A3D);color:#241300;box-shadow:0 8px 20px -10px var(--marigold-glow);}
  .btn-violet{background:var(--violet-tint);color:var(--violet);}
  .btn-ghost{background:var(--surface-2);color:var(--ink);border:1px solid var(--border);}
  .btn-block{width:100%;}
  .btn-sm{padding:6px 11px;font-size:12px;}
  .btn[disabled]{opacity:0.55;pointer-events:none;}

  .empty{text-align:center;padding:36px 20px;color:var(--ink-faint);}
  .empty-icon{font-family:'Sora',sans-serif;font-size:28px;font-weight:700;color:rgba(255,255,255,0.08);margin-bottom:6px;}
  .empty-title{font-weight:600;color:var(--ink-soft);font-size:14px;margin-bottom:3px;}
  .empty-body{font-size:12.5px;line-height:1.5;}

  label{display:block;font-size:12.5px;font-weight:600;color:var(--ink-soft);margin:14px 0 6px;}
  label:first-of-type{margin-top:0;}
  input, textarea, select{width:100%;border:1px solid var(--border);border-radius:10px;padding:10px 12px;font-family:'Inter',sans-serif;font-size:13.5px;background:rgba(255,255,255,0.03);color:var(--ink);}
  input::placeholder, textarea::placeholder{color:var(--ink-faint);}
  input:focus, textarea:focus, select:focus{outline:2px solid var(--indigo-soft);outline-offset:1px;border-color:transparent;}
  textarea{resize:vertical;min-height:70px;}
  .field-row{display:flex;gap:10px;}
  .field-row > div{flex:1;}
  .form-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px 16px 18px;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);}
  select{color-scheme:dark;}

  .profile-card{display:flex;gap:12px;align-items:flex-start;}
  .avatar{width:42px;height:42px;border-radius:50%;background:linear-gradient(150deg, var(--indigo), #423894);color:#fff;display:flex;align-items:center;justify-content:center;font-family:'Sora',sans-serif;font-weight:700;font-size:14px;flex-shrink:0;box-shadow:0 6px 16px -8px var(--indigo-glow);overflow:hidden;}
  .avatar img{width:100%;height:100%;border-radius:50%;object-fit:cover;}
  .job-image{width:100%;max-height:170px;object-fit:cover;border-radius:10px;margin:2px 0 4px;display:block;}
  input[type=file]{padding:8px 10px;font-size:12px;color:var(--ink-soft);cursor:pointer;}
  .img-preview{width:100%;max-height:130px;object-fit:cover;border-radius:10px;margin-top:8px;display:none;border:1px solid var(--border);}
  .suggest-wrap{margin-top:18px;}
  .suggest-title{font-family:'Sora',sans-serif;font-weight:700;font-size:14px;margin-bottom:8px;color:var(--ink);}
  .profile-info{flex:1;min-width:0;}
  .profile-name{font-weight:600;font-size:14px;color:var(--ink);}
  .profile-skill{font-size:12.5px;color:var(--marigold);font-weight:600;margin-top:1px;}
  .profile-bio{font-size:12.5px;color:var(--ink-soft);margin-top:5px;line-height:1.5;}
  .profile-rate{font-family:var(--mono);font-weight:700;font-size:13px;color:var(--indigo-soft);white-space:nowrap;}
  .stars{color:var(--star);font-size:12px;letter-spacing:1px;}
  .rating-line{display:flex;align-items:center;gap:6px;margin-top:4px;}
  .rating-count{font-size:11.5px;color:var(--ink-faint);font-family:var(--mono);}
  .rate-btn-row{display:flex;gap:6px;margin-top:9px;}
  .star-picker{display:flex;gap:4px;margin:8px 0;}
  .star-pick{font-size:22px;color:rgba(255,255,255,0.12);cursor:pointer;}
  .star-pick.on{color:var(--star);}

  .chat-list-item{display:flex;gap:12px;align-items:center;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:11px 13px;margin-bottom:9px;cursor:pointer;position:relative;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);}
  .chat-list-item:active{background:var(--surface-2);}
  .chat-preview{flex:1;min-width:0;}
  .chat-preview-name{font-weight:600;font-size:13.5px;color:var(--ink);}
  .chat-preview-msg{font-size:12px;color:var(--ink-faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px;}
  .unread-dot{width:9px;height:9px;border-radius:50%;background:var(--coral);flex-shrink:0;box-shadow:0 0 8px var(--coral);}
  .chat-thread{display:none;flex-direction:column;height:calc(100vh - 260px);min-height:320px;}
  .chat-thread.active{display:flex;}
  .chat-thread-head{display:flex;align-items:center;gap:10px;padding:12px 18px;border-bottom:1px solid var(--border);}
  .chat-back{background:none;border:none;font-size:18px;color:var(--indigo-soft);cursor:pointer;padding:4px 6px 4px 0;}
  .chat-body{flex:1;overflow-y:auto;padding:14px 18px;display:flex;flex-direction:column;gap:8px;}
  .bubble{max-width:75%;padding:9px 12px;border-radius:14px;font-size:13px;line-height:1.4;}
  .bubble.me{align-self:flex-end;background:linear-gradient(135deg, var(--indigo), #4A3FC4);color:#fff;border-bottom-right-radius:4px;}
  .bubble.them{align-self:flex-start;background:var(--surface-2);color:var(--ink);border:1px solid var(--border-soft);border-bottom-left-radius:4px;}
  .chat-input-row{display:flex;gap:8px;padding:12px 18px;border-top:1px solid var(--border);background:var(--bg-2);}
  .chat-input-row input{flex:1;}

  .bottomnav{
    position:fixed;bottom:10px;left:50%;transform:translateX(-50%);width:calc(100% - 24px);max-width:436px;
    background:rgba(20,22,44,0.75);border:1px solid rgba(255,255,255,0.08);border-radius:20px;display:flex;
    padding:8px 6px calc(8px + env(safe-area-inset-bottom));backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
    box-shadow:0 16px 40px -16px rgba(0,0,0,0.65);
  }
  .nav-btn{flex:1;background:none;border:none;display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 2px;cursor:pointer;color:var(--ink-faint);font-family:'Inter',sans-serif;font-size:10.5px;font-weight:600;position:relative;}
  .nav-btn.active{color:var(--indigo-soft);}
  .nav-dot{width:20px;height:20px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:12px;}
  .nav-btn.active .nav-dot{background:var(--violet-tint);color:var(--indigo-soft);box-shadow:0 0 0 1px rgba(138,124,255,0.3);}
  .nav-badge{position:absolute;top:2px;right:22%;width:8px;height:8px;border-radius:50%;background:var(--coral);box-shadow:0 0 8px var(--coral);}

  .banner{background:var(--teal-tint);color:var(--teal);border:1px solid rgba(46,230,184,0.25);font-size:11.5px;padding:8px 12px;border-radius:10px;margin:0 18px 8px;line-height:1.4;}
  .toast{position:fixed;bottom:100px;left:50%;transform:translateX(-50%);background:rgba(20,22,44,0.92);border:1px solid rgba(255,255,255,0.1);color:#fff;font-size:12.5px;padding:9px 16px;border-radius:20px;opacity:0;pointer-events:none;transition:opacity .2s ease;max-width:400px;text-align:center;z-index:50;backdrop-filter:blur(14px);}
  .toast.show{opacity:1;}

  ::-webkit-scrollbar{width:0;height:0;}
</style>
</head>
<body>

<div id="auth-screen">
  <div class="bridge-scene" aria-hidden="true">
    <svg viewBox="0 0 400 140" preserveAspectRatio="none">
      <path class="bridge-arc" d="M 10 120 Q 200 10 390 120" />
      <circle class="bridge-node" cx="10" cy="120" r="6"/>
      <circle class="bridge-node" cx="390" cy="120" r="6"/>
      <circle class="bridge-pulse" r="3.5"><animateMotion dur="3.2s" repeatCount="indefinite" path="M 10 120 Q 200 10 390 120"/></circle>
    </svg>
  </div>
  <div class="auth-mark"><svg viewBox="0 0 100 100" width="30" height="30" role="img" aria-label="Zobley mascot"><path d="M 18 46 Q 50 12 82 46 L 82 34 Q 50 2 18 34 Z" fill="#6C5CE8"/><rect x="14" y="34" width="72" height="12" rx="6" fill="#4A3FC4"/><circle cx="50" cy="60" r="34" fill="none"/><circle cx="38" cy="60" r="6" fill="#241300"/><circle cx="62" cy="60" r="6" fill="#241300"/><path d="M 38 76 Q 50 86 62 76" fill="none" stroke="#241300" stroke-width="4.5" stroke-linecap="round"/></svg></div>
  <div class="auth-title">Zobley</div>
  <div class="auth-sub">your work, your platform — log in to get started.</div>

  <div class="auth-card" id="auth-form-card">
    <label>Name</label>
    <input type="text" id="auth-name" placeholder="e.g. Rohan Sharma">
    <label>Password (min 6 characters)</label>
    <input type="password" id="auth-pass" placeholder="••••••••">
    <div id="auth-error" class="auth-error hidden"></div>
    <button class="btn btn-marigold btn-block" style="margin-top:18px;" onclick="handleAuth()" id="auth-btn">Login</button>
  </div>
  <div class="auth-loading hidden" id="auth-loading">Connecting...</div>
